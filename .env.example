# Django Configuration
DJANGO_SECRET_KEY=your-secure-secret-key-change-this-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,your-backend-domain.vercel.app

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/prime_fresh_scm
DB_NAME=prime_fresh_scm
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# MongoDB Configuration (for alternative storage)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# Frontend URLs
FRONTEND_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=Prime Fresh SCM

# API Configuration
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=3

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# AWS S3 (Optional, for file storage)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1

# Authentication
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRY_HOURS=24

# Redis (Optional, for caching)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Environment
NODE_ENV=production
ENVIRONMENT=production
